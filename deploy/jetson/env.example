# Copy to /opt/edge-ai-vision/.env on the Jetson and edit as needed.
# Used by docker-compose.jetson.yml

IMAGE=ghcr.io/mxslms/edge-ai-vision:jetson
MODEL_PATH=yolov8n.pt
# Drop to 320 if you need more FPS / less power on Orin Nano
IMG_SIZE=640
CONF_THRESHOLD=0.25
INFERENCE_DEVICE=0
FRAME_SLEEP=0.06
CAMERA_INDEX=0
HOST_PORT=5000
