[Unit]
Description=Jetson Orin Prometheus exporter (jtop metrics)
Documentation=https://github.com/pgodlews/jetson-orin-exporter
After=network-online.target jtop.service
Wants=network-online.target

[Service]
Type=simple
User=jetson_exporter
Group=jetson_exporter
SupplementaryGroups=jtop
WorkingDirectory=/opt/jetson_exporter
ExecStart=/usr/bin/python3 /opt/jetson_exporter/jetson_exporter.py
Environment=JETSON_EXPORTER_PORT=9101
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
