# Copy to /opt/edge-ai-vision/.env on the Jetson and edit as needed.
# Used by docker-compose.jetson.yml

IMAGE=ghcr.io/mxslms/edge-ai-vision:jetson
MODEL_PATH=yolov8n.pt
# Drop to 320 if you need more FPS / less power on Orin Nano
IMG_SIZE=640
CONF_THRESHOLD=0.25
INFERENCE_DEVICE=0
FRAME_SLEEP=0.06
CAMERA_INDEX=0
HOST_PORT=5000

# Motion gating (frame differencing, not PIR -- unreliable for small
# subjects at close range). Inference only runs on motion + this trailing
# window afterward.
MOTION_ENABLED=true
MOTION_THRESHOLD=0.005
MOTION_TRAILING_SECONDS=4.0
SHOW_MOTION_OVERLAY=true
CAMERA_RETRY_SECONDS=5

# Training-data capture. SAVE_CONF_FLOOR is deliberately below
# CONF_THRESHOLD -- uncertain detections are the most valuable training
# data; they're saved but never shown on the stream or counted in
# edge_detections_total.
SAVE_ENABLED=true
SAVE_CONF_FLOOR=0.25
SAVE_MIN_INTERVAL_SECONDS=2.5
SAVE_CROPS=true

# Where captures live on the HOST (bind-mounted into the container at
# /data/captures). Browse/rsync/label directly from this path.
CAPTURE_DIR_HOST=/var/lib/edge-ai-vision/captures

# Retention -- both caps enforced oldest-day-first. The byte cap is what
# actually protects an unattended device; days alone doesn't bound disk.
RETENTION_DAYS=5
RETENTION_MAX_BYTES=10737418240
RETENTION_INTERVAL_SECONDS=3600
