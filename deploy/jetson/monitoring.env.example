# Copy to /opt/edge-ai-vision/monitoring.env on the Jetson.
# Used by docker-compose.jetson-monitoring.yml and install-jetson-monitoring.sh
#
# Replace HOMELAB_IP with the LAN address of the machine running the homelab
# monitoring stack (Prometheus / Grafana / Loki).

HOMELAB_IP=192.168.1.10
LOKI_URL=http://192.168.1.10:3100/loki/api/v1/push
DEVICE_NAME=jetson-orin-nano

# Exporter ports published on the Jetson (must match homelab Prometheus targets)
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080
JETSON_EXPORTER_PORT=9101
